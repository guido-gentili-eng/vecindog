{
  "expo": {
    "name": "Vecindog",
    "slug": "guido",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "vecindog",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vecindog.app"
    },
    "android": {
      "package": "com.vecindog.app",
      "adaptiveIcon": {
        "backgroundColor": "#EE5A3B",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 14
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vecindog necesita acceso a tus fotos para subir imágenes de tu perro."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Vecindog usa tu ubicación para mostrar avisos cercanos.",
          "locationWhenInUsePermission": "Vecindog usa tu ubicación para mostrar avisos cercanos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#EE5A3B"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "7fd6c08e-33d1-423d-bedc-78f8ebed1e16"
      },
      "router": {}
    },
    "owner": "guidistos-team"
  }
}
